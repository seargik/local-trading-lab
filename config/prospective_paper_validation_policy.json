{
  "version": "28.24",
  "require_source_verdict": "pass_for_frozen_paper",
  "target_paper_days": 30,
  "max_decision_lag_minutes": 10,
  "signal_warmup_days": 120,
  "min_recorded_decision_slots": 120,
  "min_completed_trades": 20,
  "min_active_symbols": 2,
  "min_profit_factor": 1.05,
  "max_mtm_drawdown_pct": 10.0,
  "min_positive_symbol_share": 0.67,
  "min_punctuality_share": 0.95,
  "min_executable_quote_share": 0.90,
  "max_data_gap_share": 0.02,
  "max_p95_adverse_entry_slippage_bps": 25.0,
  "min_return_uplift_pct_points_vs_static": 0.0,
  "min_profit_factor_uplift_vs_static": -0.05,
  "max_family_notional_concentration": 0.75,
  "block_if_benchmark_accepted": true,
  "require_current_framework_match": true,
  "require_event_chain_integrity": true,
  "one_paper_session_per_source_result": true,
  "allow_live_execution": false,
  "allow_retroactive_signal_backfill": false
}
